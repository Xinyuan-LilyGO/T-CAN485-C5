menu "Example Configuration"

    choice
        prompt "Select the example to build"
        default EXAMPLE_BUILD_GENERAL_TEST
            config EXAMPLE_BUILD_WS2812
                bool "ws2812"
            config EXAMPLE_BUILD_SD
                bool "sd"
            config EXAMPLE_BUILD_ADC_DIGITAL_INPUT
                bool "adc_digital_input"
            config EXAMPLE_BUILD_RS485_CAN
                bool "rs485_can"
            config EXAMPLE_BUILD_ETHERNET_IPERF
                bool "ethernet_iperf"
            config EXAMPLE_BUILD_GENERAL_TEST
                bool "general_test"
    endchoice

endmenu
