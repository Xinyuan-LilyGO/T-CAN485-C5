CONFIG_IDF_TARGET="esp32c5"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

CONFIG_ETH_ENABLED=y
CONFIG_ETH_USE_SPI_ETHERNET=y
CONFIG_ETH_SPI_ETHERNET_W5500=y

CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

CONFIG_FREERTOS_HZ=1000

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_esp32c5.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_esp32c5.csv"

CONFIG_LILYGO_DEVICE_DRIVER_T_CAN485_C5=y
CONFIG_LILYGO_DEVICE_DRIVER_LOG_LEVEL_INFO=y
